# Copy these settings into backend/.env and supply local credentials.
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/usn_db
DJANGO_API_URL=http://localhost:8001
DJANGO_API_TOKEN=

# Yandex AI Studio
LLM_PROVIDER=yandex
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-5.1
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
LLM_TIMEOUT_SECONDS=45

# Optional OpenAI-compatible provider instead of Yandex:
# LLM_PROVIDER=openai-compatible
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
